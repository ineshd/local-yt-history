{
  "manifest_version": 3,
  "name": "Local YouTube History",
  "version": "1.1.0",
  "description": "Keeps YouTube watch history and progress bars entirely on your device.",
  "permissions": ["storage", "unlimitedStorage"],
  "action": {
    "default_title": "Open local watch history"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["shared.js", "content.js", "history-page.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
